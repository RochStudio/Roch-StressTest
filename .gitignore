__pycache__/
*.py[cod]
build/
dist/
.venv/
venv/
.idea/
.vscode/
*.log
*.tmp
*.bak

# Written by this program when it launches TestMem5: a copy of the profile
# picked in the window, for TM5 to fall back on. Regenerated every run.
TestMem5/bin/MT.cfg
TestMem5/bin/Roch active.cfg

# TM5's own run log, and the crash dump it writes beside it. Read by this
# program to detect failures; both are this machine's history, not source.
TestMem5/Log.txt
TestMem5/Crash.log
# TM5 0.13.1 writes its own settings here the first time it runs.
TestMem5/TM5.ini

# Prime95 keeps its state in LOCALAPPDATA, but a stray run started by hand in
# the distribution folder leaves these behind.
p95*/prime.txt
p95*/local.txt
p95*/results.txt
p95*/worktodo.txt

# Linpack input files and any transcript captured while testing.
lininput*
*_dump.txt

# Cinebench and OCCT are kept beside this program so the folder is
# self-contained, but they are gigabytes of somebody else's binaries and
# several single files are past GitHub's 100 MB limit -- CINEBENCH 2024's
# Redshift1.dat is 559 MB on its own. Committing them would make the
# repository unpushable and, because history keeps them, permanently so.
# They are found automatically wherever they sit, so being outside the
# repository costs nothing.
CINEBENCH*/
OCCT/

# What the two Linpacks leave behind when they are actually run. The same
# reasoning as the Prime95 entries above: state from a run, not the package.
Linpack-Extended-master/dependencies/temp
Linpack-Extended-master/config.json.roch-original
LinpackXtreme*/linpack.ini
LinpackXtreme*/results.txt

# RAM Test Pro writes an individual licence file here, and its own readme
# calls it exactly that. It is the licence, not part of the package: it must
# not be committed, and it was purged from history before this repository was
# made public.
ram_test_pro_*/**/license.bin

# The built EXE, copied up beside the tool folders as the README says to do.
# dist/ is ignored already; this is the copy that actually gets run.
/RochStressTest.exe
